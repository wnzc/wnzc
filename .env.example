# Render / 本地 .env 示例
# 复制为 .env，不要提交真实密钥。
#
# 服务商 URL / 模型名写在代码里：
#   server/app.py  → ACTIVE_PROVIDER + AI_PROVIDERS
#   worker.js      → ACTIVE_PROVIDER + AI_PROVIDERS
# 切换模型改代码里 ACTIVE_PROVIDER 后重新部署即可。
#
# Environment 只配 Key：

DEEPSEEK_API_KEY=sk-your-deepseek-key
# AGNES_API_KEY=sk-your-agnes-key
# GLM_API_KEY=your-glm-key

# 也可用一条 JSON（与上面分项等价）
# AI_API_KEYS={"deepseek":"sk-x","agnes":"sk-y"}

# 兼容旧配置：只配一把 Key 时挂在代码里的 ACTIVE_PROVIDER 上
# AI_API_KEY=sk-xxx

# 其它第三方
UUHB_API_KEY=your_uuhb_key
# LOTTERY_TOKEN=

# 签名（与前端 src/ai-config.js 的 AI_SIGN.secret 一致）
SIGN_SECRET=wnzc-soft-sign-2026
