# Cloudflare Worker 环境变量配置示例
# 复制此文件为 .env，填入真实密钥，然后提交 .env.example（不要提交 .env）

# AI 服务商配置
AI_API_URL=https://api.agnes-ai.cn/v1/chat/completions
AI_API_KEY=your_new_agnes_api_key_here
AI_MODEL=agnes-2.5-flash

# 智谱 GLM（备用）
# AI_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
# AI_API_KEY=your_glm_api_key_here

# DeepSeek（备用）
# AI_API_URL=https://api.deepseek.com/chat/completions
# AI_API_KEY=your_deepseek_api_key_here

# uuhb.cn 第三方服务（运势/答案之书）
UUHB_API_KEY=your_new_uuhb_api_key_here

# 彩票接口 token（可选）
# LOTTERY_TOKEN=your_lottery_token_here
